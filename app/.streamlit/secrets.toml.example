# Copy these values to Streamlit Community Cloud secrets for live data.
APP_DATA_MODE = "live"
SNOWFLAKE_DATABASE = "DBT_DB"
SNOWFLAKE_ANALYTICS_SCHEMA = "DBT_SCHEMA"

[connections.snowflake]
account = "org-account"
user = "user"
password = "password"
role = "DBT_ROLE"
warehouse = "DBT_WH"
database = "DBT_DB"
schema = "DBT_SCHEMA"
